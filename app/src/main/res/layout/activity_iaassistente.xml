<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cinza"
    android:fitsSystemWindows="true">


    <!-- ============================================= -->
    <!-- CABEÇALHO                                     -->
    <!-- ============================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 Assistente de Estudos"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pergunte sobre o conteúdo que você está estudando."
            android:textSize="14sp" />

    </LinearLayout>


    <!-- ============================================= -->
    <!-- CONTEÚDO SELECIONADO                          -->
    <!-- ============================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:padding="12dp"
        android:orientation="vertical"
        android:background="@android:color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📘 Conteúdo atual"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoContexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ============================================= -->
    <!-- ÁREA DE RESPOSTA                              -->
    <!-- ============================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/textoRespostaIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Faça uma pergunta sobre este conteúdo."
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ============================================= -->
    <!-- CAMPO DA PERGUNTA                             -->
    <!-- ============================================= -->

    <EditText
        android:id="@+id/campoPergunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:hint="Digite sua pergunta..."
        android:inputType="textMultiLine"
        android:minHeight="60dp"
        android:maxLines="5"
        android:gravity="top|start"
        android:padding="12dp"
        android:background="@android:color/white" />


    <!-- ============================================= -->
    <!-- BOTÃO PERGUNTAR                               -->
    <!-- ============================================= -->

    <Button
        android:id="@+id/btnEnviarPergunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:text="🤖 Perguntar"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>